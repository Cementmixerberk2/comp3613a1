        {
          "name": "Register new student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{student_username}}\",\n  \"email\": \"{{student_username}}@example.com\",\n  \"password\": \"{{student_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new student each run, so the collection can be run again without resetting the database.",
                  "const name = 'student_' + Date.now();",
                  "pm.collectionVariables.set(\"student_username\", name);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Creates a student account without exposing the password\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.username).to.eql(pm.collectionVariables.get(\"student_username\"));",
                  "    pm.expect(body.role).to.eql(\"student\");",
                  "    pm.expect(body).to.not.have.property(\"password\");",
                  "});"
                ]
              }
            }
          ]
        },
