    {
      "name": "3. Applications (Workflows 2 and 3: Apply and Match)",
      "item": [
        {
          "name": "Apply to position (student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/positions/{{position_id}}/applications",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "positions",
                "{{position_id}}",
                "applications"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cover_note\": \"I have experience writing automated tests with pytest.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Application is recorded as Submitted\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(\"Submitted\");",
                  "    pm.expect(body.position_id).to.eql(Number(pm.collectionVariables.get(\"position_id\")));",
                  "    pm.collectionVariables.set(\"application_id\", body.id);",
                  "});"
                ]
              }
            }
          ]
        },
