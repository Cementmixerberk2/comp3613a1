{
  "info": {
    "_postman_id": "15f75358-dcdf-44d1-a70e-f83b2c4e3932",
    "name": "Internship Platform API",
    "description": "API tests for the COMP 3613 Internship Platform.\n\nBefore running: `python manage.py init` (resets and seeds the database) then `python manage.py run`. Run the whole collection in order with the Collection Runner. It registers a new student and posts a new position each run, so it can be re-run without resetting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns a bearer token for an admin\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.token_type).to.eql(\"bearer\");",
                  "    pm.expect(body.role).to.eql(\"admin\");",
                  "    pm.collectionVariables.set(\"admin_token\", body.access_token);",
                  "});"
                ]
              }
            }
          ]
        },
